{
  "rules": {
    "liveLocations": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'superadmin')",
        ".validate": "newData.hasChildren(['lat', 'lng', 'updatedAt'])"
      }
    },
    "jobTracking": {
      "$jobId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'superadmin' || (!data.exists() || data.child('workerId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['jobId', 'workerLocation', 'updatedAt'])"
      }
    }
  }
}
