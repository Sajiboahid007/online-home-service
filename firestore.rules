rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function role()        { return request.auth.token.role; }
    function isSuper()     { return signedIn() && role() == 'superadmin'; }
    function isAdmin()     { return signedIn() && (role() == 'admin' || role() == 'superadmin'); }
    function isOwner(uid)  { return signedIn() && request.auth.uid == uid; }
    function notBanned()   { return request.auth.token.banned != true; }
    function isJobParticipant(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return signedIn() && (job.customerId == request.auth.uid || job.workerId == request.auth.uid);
    }

    // Users collection
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      allow update: if isAdmin() ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'status', 'rating', 'ratingCount', 'banReason']));
      allow delete: if isSuper();
    }

    // Worker public profile - visible to all authenticated users
    match /workers/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() ||
        (isOwner(uid) && notBanned()
          && request.resource.data.uid == uid
          && request.resource.data.verified == false
          && request.resource.data.verificationStatus == 'pending'
          && request.resource.data.trustedBadge == false
          && request.resource.data.isPremium == false
          && request.resource.data.walletBalance == 0
          && request.resource.data.commissionDue == 0
          && request.resource.data.totalJobs == 0);
      allow update: if isAdmin() ||
        (isOwner(uid) && notBanned() && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verified', 'verificationStatus', 'rating', 'ratingCount', 'totalJobs',
                   'walletBalance', 'commissionDue', 'trustedBadge', 'isPremium']));
    }

    // Worker private sensitive data (NID, selfie, bank details)
    match /workerPrivate/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if isAdmin() ||
        (signedIn() && (resource.data.customerId == request.auth.uid ||
                        resource.data.workerId == request.auth.uid)) ||
        (role() == 'worker' && resource.data.status == 'searching');
      allow create: if role() == 'customer' && notBanned()
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'pending';
      // Transitions and assignments handled securely without tampering financial/OTP fields
      allow update: if isAdmin() ||
        (signedIn() && notBanned()
          && (resource.data.customerId == request.auth.uid || resource.data.workerId == request.auth.uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['customerId', 'startOtp', 'completionOtp', 'commission', 'platformFee', 'workerEarning', 'paymentStatus']));

      // Offers subcollection
      match /offers/{workerId} {
        allow read: if isAdmin() || isOwner(workerId) || isJobParticipant(jobId);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() ||
          (isOwner(workerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      }

      // Bids subcollection
      match /bids/{workerId} {
        allow read: if isAdmin() || isOwner(workerId) || isJobParticipant(jobId);
        allow write: if isOwner(workerId) || isAdmin();
      }

      // Messages subcollection (chat) - restricted to job participants & admins
      match /messages/{msgId} {
        allow read: if isAdmin() || isJobParticipant(jobId);
        allow create: if (isAdmin() || isJobParticipant(jobId)) && notBanned()
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Reviews
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Financial Transactions
    match /transactions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.workerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Reports / Disputes
    match /reports/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin();
    }

    // SOS Alerts
    match /sosAlerts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn();
      allow update: if isAdmin();
    }

    // Platform settings
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // Public taxonomy & config
    match /categories/{id} { allow read: if true;     allow write: if isSuper(); }
    match /areas/{id}      { allow read: if true;     allow write: if isAdmin(); }
    match /pricing/{id}    { allow read: if true;     allow write: if isSuper(); }
    match /coupons/{id}    { allow read: if signedIn(); allow write: if isSuper(); }
    match /auditLogs/{id}  { allow read: if isSuper(); allow write: if isAdmin(); }
    match /blacklist/{id}  { allow read, write: if isSuper(); }
  }
}
