rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin'); }

    // User/Worker Profile pictures: public read, owner write (max 5MB, image only)
    match /profile/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(uid) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // KYC Documents (NID, selfie, police clearance): Private (owner & admin only)
    match /kyc/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Job pictures (fault photos, after-work verification): create-only by signed-in users, never overwrite existing files
    match /jobs/{jobId}/{allPaths=**} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }
  }
}
